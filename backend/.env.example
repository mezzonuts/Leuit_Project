# LEUIT Backend Environment Variables
# Copy this file to .env and fill in your values

# App Settings
APP_NAME=LEUIT
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_PATH=./leuit_store.enc
# DATABASE_KEY=  # Set at runtime after unlock

# Security - Ed25519 Public Key (64 hex chars)
# Generate with: python scripts/generate_keys.py
CLOUD_PUBLIC_KEY=

# License
LICENSE_FILE_PATH=~/.leuit/license.key
GRACE_PERIOD_DAYS=3

# BMKG Weather API
BMKG_API_BASE=https://api.bmkg.go.id/publik/prakiraan-cuaca
BMKG_DEFAULT_ADM4=32.73.08.1001

# Forecasting
FORECAST_HORIZON_DAYS=7
SAFETY_STOCK_MULTIPLIER=1.2

# API Server
API_HOST=127.0.0.1
API_PORT=8000